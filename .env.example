# DB-Pulse Server Configuration

# Server Port (default: 3001)
PORT=3001

# Optional: Default Database Connection String
# e.g., MySQL: mysql://user:password@host:port/database?ssl-mode=REQUIRED
#       PostgreSQL: postgresql://user:password@host:port/database?sslmode=require
#       MongoDB: mongodb+srv://user:password@cluster.mongodb.net/database
DEFAULT_DB_CONNECTION=

# Optional: Aiven API credentials for auto-recovery
AIVEN_API_TOKEN=
AIVEN_PROJECT=
AIVEN_SERVICE=

# Optional: SMTP Configuration for Email Alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAILS=
